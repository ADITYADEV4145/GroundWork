{
  "name": "groundwork-agent",
  "version": "0.0.1",
  "description": "A live, local map of your codebase for coding agents: navigation, reuse-first duplicate gate, grounding checks and waste guards.",
  "type": "module",
  "license": "MIT",
  "author": "Aditya Punjani",
  "repository": {
    "type": "git",
    "url": "https://github.com/ADITYADEV4145/GroundWork.git"
  },
  "bin": {
    "gw": "dist/cli/main.js"
  },
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": "./dist/api.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "gw": "node --import tsx src/cli/main.ts",
    "selftest": "node --import tsx src/cli/main.ts selftest",
    "golden": "node --import tsx scripts/update-golden.ts",
    "calibrate": "node --import tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "ignore": "^7.0.16",
    "picomatch": "^4.0.7",
    "sql.js": "^1.17.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/sql.js": "^1.16.0",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
