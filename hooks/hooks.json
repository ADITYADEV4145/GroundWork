{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "gw hook claude prompt", "timeout": 10 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "gw hook claude pre_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__groundwork__find_code|mcp__plugin_groundwork_groundwork__find_code",
        "hooks": [
          {
            "type": "command",
            "command": "gw hook claude post_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gw hook claude pre_compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gw hook claude stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
