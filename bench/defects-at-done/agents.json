      "id": "claude-code",
      "command": ["claude", "-p", "{prompt}", "--output-format", "json", "--model", "{model}", "--max-turns", "{maxTurns}", "--dangerously-skip-permissions", "--mcp-config", "{mcpConfig}", "--strict-mcp-config"],
