{
  "name": "groundwork-agent",
  "version": "0.0.1",
  "description": "A live, local map of your codebase for coding agents: navigation, reuse-first duplicate gate, grounding checks and waste guards.",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "provenance": true, "access": "public" },
  "author": "Aditya",
  "repository": {
    "type": "git",
    "url": "https://github.com/ADITYADEV4145/GroundWork.git"
  },
  "bin": {
    "gw": "dist/cli/main.js"
  },
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": "./dist/api.js"
  },
  "files": [
    "dist",
    "fixtures",
    "SKILL.md",
    "references",
    "docs",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-hook.mjs",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "gw": "node --import tsx src/cli/main.ts",
    "selftest": "node --import tsx src/cli/main.ts selftest --install-check",
    "bench:grounding": "node --import tsx scripts/bench-grounding.ts",
    "bench:types": "node --import tsx scripts/bench-types.ts",
    "bench:impact": "node --import tsx scripts/bench-impact.ts",
    "bench:deps": "node --import tsx scripts/bench-deps.ts",
    "setup:deps-bench": "node --import tsx scripts/setup-deps-bench.ts",
    "setup:grounding-repos": "node --import tsx scripts/setup-grounding-repos.ts",
    "bench:v2": "node --import tsx scripts/bench-v2.ts",
    "bench:charts": "node scripts/bench-charts.mjs",
    "golden": "node --import tsx scripts/update-golden.ts",
    "calibrate": "node --import tsx scripts/calibrate.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "ignore": "^7.0.16",
    "picomatch": "^4.0.7",
    "sql.js": "^1.17.0",
    "tree-sitter-c-sharp": "0.24.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "5.9.3",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/sql.js": "^1.16.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "yaml": "2.8.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "coding-agent",
    "agent-skill",
    "code-index",
    "tree-sitter"
  ],
  "homepage": "https://github.com/ADITYADEV4145/GroundWork#readme",
  "bugs": {
    "url": "https://github.com/ADITYADEV4145/GroundWork/issues"
  }
}
